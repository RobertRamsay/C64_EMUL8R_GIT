{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "C64EMUL8R",
  "mainBinaryName": "C64EMUL8R",
  "version": "0.1.0",
  "identifier": "com.polytricity.c64emul8r",
  "build": {
    "frontendDist": "../dist/renderer",
    "beforeBuildCommand": "node build.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "C64EMUL8R",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "backgroundColor": "#15171c",
        "dragDropEnabled": true,
        "backgroundThrottling": "disabled",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["../build/icon.png", "../build/icon.ico", "../build/icon.icns"]
  }
}
