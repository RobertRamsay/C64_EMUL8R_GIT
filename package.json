{
  "name": "c64emul8r",
  "version": "0.1.0",
  "description": "C64EMUL8R - Commodore 64 / C64 Ultimate emulator with built-in debugger",
  "main": "dist/main/main.js",
  "author": "Robert Ramsay",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "start": "node build.mjs && electron .",
    "typecheck": "tsc --noEmit -p .",
    "test": "node build.mjs --tests && node dist/tests/headless.js",
    "package": "node build.mjs && electron-packager . C64EMUL8R --platform=win32 --arch=x64 --icon=build/icon.ico --out=release --overwrite --prune=true --ignore=^/src --ignore=^/tools --ignore=^/assets --ignore=^/release --ignore=\\.map$ --ignore=^/dist/tests --ignore=^/build --ignore=^/tsconfig\\.json --ignore=^/README\\.md --ignore=^/\\.git",
    "package:mac": "node build.mjs && node tools/package-mac.mjs",
    "icons": "electron tools/make-icons.mjs",
    "bundle:devmachine": "npm run package && node tools/bundle-devmachine.mjs",
    "bundle:devmachine-mac": "npm run package:mac && node tools/bundle-devmachine-mac.mjs",
    "package:mac-tauri": "node tools/package-mac.mjs --tauri",
    "bundle:devmachine-mac-tauri": "npm run package:mac-tauri && node tools/bundle-devmachine-mac.mjs --tauri",
    "tauri:build": "node tools/tauri.mjs build --no-bundle",
    "tauri:dev": "node tools/tauri.mjs dev",
    "bundle:devmachine-tauri": "npm run tauri:build && node tools/bundle-devmachine.mjs --tauri"
  },
  "devDependencies": {
    "@electron/packager": "^18.3.6",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^22.10.2",
    "electron": "^33.2.1",
    "esbuild": "^0.24.2",
    "typescript": "^5.6.3"
  }
}
